endif
endif
ifeq ($(TH08_PSP_TRIG_DF_FASTPATH_AUDIT)$(TH08_PSP_TRIG_DF_FASTPATH),00)
PSP_TRIG_DF_SRCS :=
else
PSP_TRIG_DF_SRCS := psp/trig_df_fastpath.cpp
endif

ifeq ($(TH08_PSP_PERF_ENV),1)
ifneq ($(TH08_PSP_PERF_ATTRIBUTION),1)
$(error TH08_PSP_PERF_ENV=1 requires TH08_PSP_PERF_ATTRIBUTION=1)
endif
PSP_PERF_ENV_SRCS := psp/perf_env.cpp
else ifeq ($(TH08_PSP_PERF_ENV),0)
PSP_PERF_ENV_SRCS :=
else
$(error TH08_PSP_PERF_ENV must be 0 or 1)
endif

ifneq ($(filter-out 0 1,$(TH08_PSP_SWAP_NOWAIT)),)
$(error TH08_PSP_SWAP_NOWAIT must be 0 or 1)
endif
ifeq ($(TH08_PSP_SWAP_ASYNC),1)
ifneq ($(TH08_PSP_SWAP_NOWAIT),1)
$(error TH08_PSP_SWAP_ASYNC=1 requires TH08_PSP_SWAP_NOWAIT=1)
endif
else ifneq ($(TH08_PSP_SWAP_ASYNC),0)
$(error TH08_PSP_SWAP_ASYNC must be 0 or 1)

	@touch $@

# psp-ld can require private symbols but cannot assert their ELF st_size.
# Gate EBOOT packing on a post-link ABI/disassembly audit so an SDK allocator
# replacement cannot silently turn the read-only heap scanner into an unsafe
# metadata walk.
$(NEWLIB_HEAP_ABI_STAMP): $(TARGET).elf scripts/check_psp_newlib_heap_abi.py
	@mkdir -p $(dir $@)
	python3 scripts/check_psp_newlib_heap_abi.py $(TARGET).elf \
		--nm $(PSPDEV)/bin/psp-nm --objdump $(PSPDEV)/bin/psp-objdump
	@touch $@

EBOOT.PBP: $(NEWLIB_HEAP_ABI_STAMP) $(PSPGL_GE4_LINK_STAMP) \
	$(GE4_PROVEN_PRX)

$(OBJS): $(GENERATED_I18N) $(GE4_MODEL_GATE_CONFIG_STAMP) \
	$(BULLET_VM_CONFIG_STAMP) \
	$(REPLAY_AUDIT_CONFIG_STAMP) $(RENDER_VFPU_CONFIG_STAMP) \
	$(RUNTIME_TELEMETRY_CONFIG_STAMP) \
	$(X87_TRIG_CACHE_CONFIG_STAMP) \
	$(BULLET_FASTPATH_CONFIG_STAMP) $(BULLET_UNIFIED_QUADS_CONFIG_STAMP) \
	$(BULLET_DIRECT_GE_CONFIG_STAMP) $(ITEM_DIRECT_GE_CONFIG_STAMP)

# The diagnostic exists in exactly these call-site owners.  Its source and
# linker wrappers are absent in OFF builds; the stamp prevents stale ON/OFF
# objects from surviving an incremental switch.
src/main.o src/BulletManager.o src/ItemManager.o src/EffectManager.o \
	src/EnemyManager.o src/EnemyManagerUpdate.o src/Player.o \
	src/modern/linux/d3d8_compat.o psp/main.o psp/perf_attribution.o: \
	$(PERF_ATTRIBUTION_CONFIG_STAMP)

# The child sampler changes only the central draw dispatcher, one nested
# Background callsite, its fixed observer, the parent window owner, and the
# persisted boot identity.  OFF/ON switches invalidate that exact closure.
src/Global.o src/Background.o psp/draw_priority_subprofile.o \
	psp/perf_attribution.o psp/main.o: \
	$(DRAW_PRIORITY_SUBPROFILE_CONFIG_STAMP)

# The Item update sub-profile spans only ItemManager::OnUpdate, its fixed
# observer, the parent window owner, and the persisted boot identity.
src/ItemManager.o psp/item_update_subprofile.o psp/perf_attribution.o \
	psp/main.o: $(ITEM_UPDATE_SUBPROFILE_CONFIG_STAMP)

# The atan2 audit/product switches span the Item autocollect caller, the
# statistics observer, the parent window owner, and the boot identity.
src/ItemManager.o psp/item_atan2_audit.o psp/perf_attribution.o psp/main.o: \
	$(ITEM_ATAN2_FASTPATH_AUDIT_CONFIG_STAMP) $(ITEM_ATAN2_FASTPATH_CONFIG_STAMP)

# The sin/cos audit/product switches span the Item velocity helper, the
# statistics observer, the parent window owner, and the boot identity.
src/ItemManager.o psp/item_sincos_audit.o psp/perf_attribution.o psp/main.o: \
	$(ITEM_SINCOS_FASTPATH_AUDIT_CONFIG_STAMP) $(ITEM_SINCOS_FASTPATH_CONFIG_STAMP)

# The census changes only the phase bookkeeping in the attribution scope, its
# own observer, the link-time wrappers, and the boot identity.
psp/softfloat_census.o psp/perf_attribution.o psp/main.o: \
	$(SOFTFLOAT_CENSUS_CONFIG_STAMP)

# The audio cursor switches span the SC mixer, its observer, the parent
# window owner, and the boot identity.
src/modern/linux/linux_compat.o psp/audio_cursor_audit.o psp/perf_attribution.o psp/main.o: \
	$(AUDIO_FIXED_CURSOR_AUDIT_CONFIG_STAMP) $(AUDIO_FIXED_CURSOR_CONFIG_STAMP)

# The trig fast-path switches live in ZunMath.hpp, which every game object
# includes, plus the observer, the parent window owner, and the boot identity.
$(filter src/%.o,$(OBJS)) psp/trig_df_fastpath.o psp/perf_attribution.o psp/main.o: \
	$(TRIG_DF_FASTPATH_AUDIT_CONFIG_STAMP) $(TRIG_DF_FASTPATH_CONFIG_STAMP)

# The environment record spans its observer, the attribution scopes and
# wrappers, the draw-priority GE-wait bins, and the boot identity.
psp/perf_env.o psp/perf_attribution.o psp/draw_priority_subprofile.o psp/main.o: \
	$(PERF_ENV_CONFIG_STAMP)

# The no-wait swap spans the compat device (swap interval, flip guard), the
# cadence wait in the game loop, and the boot identity.
src/modern/linux/d3d8_compat.o src/main.o psp/main.o psp/swap_async.o: \
	$(SWAP_NOWAIT_CONFIG_STAMP)

# The async flip spans the compat device, its thread module, the environment
# record (flip-guard wait), and the boot identity.
src/modern/linux/d3d8_compat.o psp/swap_async.o psp/perf_env.o psp/main.o: \
	$(SWAP_ASYNC_CONFIG_STAMP)

# The colour-only flip guard spans the compat device (Clear entry) and the
# boot identity.
src/modern/linux/d3d8_compat.o psp/main.o: \
	$(FLIP_GUARD_COLOR_ONLY_CONFIG_STAMP)

# The PSPGL stream arena spans the compat device (synchronous frame lease) and
# the boot identity.
src/modern/linux/d3d8_compat.o psp/main.o: \
	$(PSPGL_STREAM_ARENA_CONFIG_STAMP)

# The replay reservation recycle spans the replay manager and the boot identity.
src/ReplayManager.o psp/main.o: \
	$(REPLAY_RESERVE_RECYCLE_CONFIG_STAMP)

# The dialogue snapshot promotion exclusion spans the compat device and the
# boot identity.
src/modern/linux/d3d8_compat.o psp/main.o: \
	$(DIALOGUE_SNAPSHOT_NO_PROMOTE_CONFIG_STAMP)

# The dialogue snapshot diagnostic spans the compat device and the boot identity.
src/modern/linux/d3d8_compat.o psp/main.o: \
	$(DIALOGUE_SNAPSHOT_DIAG_CONFIG_STAMP)

# The Go storage diagnostic spans its fixed state module, the Win32/POSIX
# bridge, the PSP-only archive-request stdio trace, the final overlay, and the
# persisted feature fingerprint.  Switching OFF/ON rebuilds that exact set.
psp/io_activity_lamp.o psp/fileio.o src/main.o \
	src/modern/linux/linux_compat.o src/modern/linux/linux_runtime.o \
	psp/main.o: \
	$(GO_IO_LAMP_CONFIG_STAMP)

# The storage serialization spans the lamp module, the Win32/POSIX bridge
# (font stream) and the boot identity.
psp/io_activity_lamp.o src/modern/linux/linux_compat.o psp/main.o: \
	$(IO_SERIALIZE_CONFIG_STAMP)

# The high-memory bounce spans the bridge and the boot identity.
src/modern/linux/linux_compat.o psp/main.o: \
	$(IO_BOUNCE_HIGH_CONFIG_STAMP)

# The font stream cache spans the bridge and the boot identity.
src/modern/linux/linux_compat.o psp/main.o: \
	$(FONT_STREAM_CACHE_CONFIG_STAMP)

# The dialogue snapshot relocation spans the background chain, the compat
# device and the boot identity.
src/Background.o src/modern/linux/d3d8_compat.o psp/main.o: \
	$(DIALOGUE_SNAPSHOT_AT_BACKGROUND_CONFIG_STAMP)

# The live dialogue background spans the background chain, the compat device
# and the boot identity.
src/Background.o src/modern/linux/d3d8_compat.o psp/main.o: \
	$(DIALOGUE_LIVE_BACKGROUND_CONFIG_STAMP)

# The tick gate bypass spans the game loop and the boot identity.
src/main.o psp/main.o: \
	$(TICK_GATE_BYPASS_CONFIG_STAMP)

# The triple buffer spans the compat device (Present), the game loop (poll),
# its module, the list hook, the display query module and the boot identity.
src/modern/linux/d3d8_compat.o src/main.o psp/main.o psp/swap_triple.o \
psp/swap_async.o psp/ge_list_hook.o psp/perf_env.o psp/stage_pool_arena.o: \
	$(SWAP_TRIPLE_CONFIG_STAMP)
psp/ge_list_hook.o: $(PERF_ENV_CONFIG_STAMP)

# The border replay spans Gui::DrawGameScene, its observer, the parent window
# owner, and the boot identity.
src/Gui.o psp/gui_border_replay.o psp/perf_attribution.o psp/main.o: \
	$(GUI_BORDER_REPLAY_AUDIT_CONFIG_STAMP) $(GUI_BORDER_REPLAY_CONFIG_STAMP)

# Only the presentation scheduler consumes the diagnostic boot mode.  Its
# public API and every game/replay object remain identical across mode 0/2.
psp/render_cadence.o: $(RENDER_CADENCE_INITIAL_MODE_CONFIG_STAMP)

# The one-pass switch spans only the fired-Bullet caller, its AnmManager
# staging owner, and the persisted boot fingerprint.  OFF/AUDIT/PRODUCT share
# the same fixed 80-byte stats reservation.
src/BulletManager.o src/AnmManager.o psp/main.o: \
	$(BULLET_ONEPASS_4V_AUDIT_CONFIG_STAMP) \
	$(BULLET_ONEPASS_4V_FASTPATH_CONFIG_STAMP)

# Only the compatibility renderer and boot fingerprint consume this toggle.
src/modern/linux/d3d8_compat.o psp/main.o: $(PREPARE_STATE_CACHE_CONFIG_STAMP)

# The radial candidate changes only EffectManager's draw-only zero-secondary
# branch.  Rebuild it and the boot identity together for every OFF/ON switch.
src/EffectManager.o psp/main.o: $(RADIAL_TRAIL_TRIG_REUSE_CONFIG_STAMP)
src/PlayerBomb.o psp/main.o: $(FANTASY_SEAL_WORK_BOUNDS_CONFIG_STAMP)
src/EffectManager.o psp/main.o: $(EFFECT_OCCUPANCY_FASTPATH_CONFIG_STAMP)
src/EffectManager.o psp/effect_occupancy_audit.o psp/perf_attribution.o psp/main.o: \
	$(EFFECT_OCCUPANCY_AUDIT_CONFIG_STAMP)
src/EffectManager.o psp/main.o: $(EFFECT_SPRITE_PAIR_AUDIT_CONFIG_STAMP)
src/EffectManager.o src/modern/linux/d3d8_compat.o psp/main.o: \
	$(EFFECT_SPRITE_PAIR_FASTPATH_CONFIG_STAMP)
src/GameManager.o psp/main.o: $(ANTITAMPER_SWAR_CONFIG_STAMP)
src/AnmManager.o src/EffectManager.o psp/memory_telemetry.o psp/main.o: \
	$(EFFECT_INDEXED_QUADS_CONFIG_STAMP)

# M0 is backend-only and observational.  Rebuild the canonical vertex owner,
# its cumulative telemetry reader, and the boot identity as one configuration.
src/modern/linux/d3d8_compat.o psp/memory_telemetry.o psp/main.o: \
	$(BULLET_PACKED_VERTEX_AUDIT_CONFIG_STAMP)

# M1 spans the final-quad frontend boundary, the compatibility renderer's
# Present-fenced arena, cumulative telemetry, and the boot identity.
src/AnmManager.o src/modern/linux/d3d8_compat.o psp/memory_telemetry.o \
	psp/main.o: $(BULLET_PACKED_VERTEX_FASTPATH_CONFIG_STAMP)

# Recompile one real linker input whenever the frozen PSPGL archive changes.
# This turns archive provenance changes into a relink without injecting the
# empty validation stamp itself into PSPSDK build.mak's `$^` link input list.
src/modern/linux/d3d8_compat.o: $(PSPGL_GE4_ARCHIVE_STAMP)
src/modern/linux/d3d8_compat.o: $(PSPGL_GE4_SELECTED_ARCHIVE_STAMP)

# Mixed classification and submission span exactly these five translation
# units: frontend/sidecar, PSPGL bridge, boot identity, interval telemetry, and
# the BulletManager draw-chain owner.
# Switching either bit invalidates them together without rebuilding gameplay
# owners that do not consume the experiment macros.
src/AnmManager.o src/modern/linux/d3d8_compat.o psp/main.o \
	psp/memory_telemetry.o src/BulletManager.o: \
	$(BULLET_MIXED_QUADS_AUDIT_CONFIG_STAMP) \
	$(BULLET_MIXED_QUADS_FASTPATH_CONFIG_STAMP) \
	$(ITEM_MIXED_QUADS_AUDIT_CONFIG_STAMP) \
	$(ITEM_MIXED_QUADS_FASTPATH_CONFIG_STAMP)

# Player owns this external scan cache and main emits its boot fingerprint.
# Rebuild both consumers so an incremental OFF/ON A/B can never carry a stale
# feature identity into the runtime log.
src/Player.o psp/main.o: $(PLAYER_SCAN_SIDECAR_CONFIG_STAMP) \
	$(CANCEL_EMPTY_FASTPATH_CONFIG_STAMP)

src/EnemyManager.o src/EnemyManagerUpdate.o src/EnemyTimeline.o \
	psp/enemy_active_bitmap_audit.o psp/main.o: \
	$(ENEMY_ACTIVE_BITMAP_AUDIT_CONFIG_STAMP)

# The all-frame cancel gate spans Player coverage, Bullet occupancy/duplicate
# replay, interval telemetry, and the persisted boot fingerprint.
src/Player.o src/BulletManager.o psp/memory_telemetry.o psp/main.o: \
	$(BULLET_CANCEL_SPATIAL_CONFIG_STAMP)

# The collision audit spans the canonical Bullet calls, Player's immutable
# frame snapshot, interval telemetry, and the boot identity.  Rebuild every
# consumer together while retaining BulletManager's unconditional audit BSS.
src/BulletManager.o src/Player.o psp/memory_telemetry.o psp/main.o: \
	$(BULLET_COLLISION_GATE_AUDIT_CONFIG_STAMP)
src/BulletManager.o psp/bullet_gate_stats.o psp/perf_attribution.o psp/main.o: \
	$(BULLET_COLLISION_GATE_CONFIG_STAMP)

# BulletManager owns the dynamic enumerator, telemetry reads and resets its
# interval counters, and main records the exact A/B identity.
src/BulletManager.o psp/memory_telemetry.o psp/main.o: \
	$(BULLET_LIVE_ENUM_CONFIG_STAMP) \
	$(BULLET_TRANSFORM_AUDIT_CONFIG_STAMP) \
	$(BULLET_TRANSFORM_TERMINAL_FASTPATH_CONFIG_STAMP)

# The observer, telemetry reader, and boot fingerprint must switch together;
# production builds retain the exact canonical Item path and no audit BSS.
src/ItemManager.o src/AnmManager.o psp/memory_telemetry.o psp/main.o: \
	$(ITEM_AUTOCOLLECT_CACHE_AUDIT_CONFIG_STAMP) \
	$(ITEM_AUTOCOLLECT_CACHE_CONFIG_STAMP) \
	$(ITEM_TIME_SPAWN_INIT_AUDIT_CONFIG_STAMP) \
	$(ITEM_TIME_SPAWN_INIT_FASTPATH_CONFIG_STAMP) \
	$(ITEM_TIME_ANM_IDLE_AUDIT_CONFIG_STAMP) \
	$(ITEM_TIME_ANM_IDLE_FASTPATH_CONFIG_STAMP) \
	$(ITEM_TIME_DRAW_PAIR_AUDIT_CONFIG_STAMP) \
	$(ITEM_TIME_DRAW_PAIR_FASTPATH_CONFIG_STAMP) \
	$(ITEM_NATURAL_QUADS_CONFIG_STAMP)

# The inline experiment changes only ItemManager's stock ITEM_TIME frontend;
# main persists the exact OFF/AUDIT/PRODUCT identity in every hardware log.
src/ItemManager.o psp/main.o: \
	$(ITEM_TIME_INLINE_DRAW_AUDIT_CONFIG_STAMP) \
	$(ITEM_TIME_INLINE_DRAW_FASTPATH_CONFIG_STAMP)

# Product additionally consumes the generic mutable in-place PSPGL pair
# bridge.  Audit keeps the backend untouched but shares the same source stamp.
src/modern/linux/d3d8_compat.o: \
	$(ITEM_TIME_DRAW_PAIR_AUDIT_CONFIG_STAMP) \
	$(ITEM_TIME_DRAW_PAIR_FASTPATH_CONFIG_STAMP) \
	$(ITEM_NATURAL_QUADS_CONFIG_STAMP)

# Native-copy changes only the natural frontend's submit result accounting,
# the PSPGL compatibility backend, interval policy text, and boot identity.
# The fixed 152-byte Item sidecar and gameplay owners remain unchanged.
src/AnmManager.o src/modern/linux/d3d8_compat.o psp/memory_telemetry.o \
	psp/main.o: $(ITEM_NATURAL_NATIVE_COPY_CONFIG_STAMP)

# AsciiManager owns the derived popup occupancy; main logs the exact toggle.
src/AsciiManager.o psp/main.o: $(ASCII_POPUP_OCCUPANCY_CONFIG_STAMP)

# The score-only pair frontend spans AsciiManager, AnmManager and the PSPGL
# compatibility submitter; rebuild all consumers plus the boot fingerprint.
src/AsciiManager.o src/AnmManager.o src/modern/linux/d3d8_compat.o \
	psp/main.o: $(ASCII_POPUP_BATCH_CONFIG_STAMP)

# This path changes only AnmManager's score-batch frontend and boot identity;
# the accepted PSPGL pair backend and AsciiManager owner are unchanged.
src/AnmManager.o psp/main.o: $(ASCII_POPUP_DIRECT_PAIR_CONFIG_STAMP)

# M0 changes the score-popup backend submit, its persisted runtime counters,
# and the boot fingerprint.  The frontend batch stamp remains independent for
# client-array/native A/B.
src/modern/linux/d3d8_compat.o psp/memory_telemetry.o psp/main.o: \
	$(SCORE_POPUP_NATIVE_GE_CONFIG_STAMP)

# The sampler is diagnostic-only.  Rebuild its sole owner and the boot
# fingerprint together so archived A/B evidence cannot have a stale identity.
psp/memory_telemetry.o psp/main.o: \
	$(STAGE_RELATIVE_PERF_SAMPLING_CONFIG_STAMP)

src/modern/linux/linux_compat.o psp/main.o: $(FONT_SUBSET_CONFIG_STAMP)
src/modern/linux/linux_compat.o psp/main.o: \
	$(FONT_GLYPH_CACHE_RETAIN_CONFIG_STAMP)

# Only this translation unit owns module/newlib declarations. The dedicated
# stamp makes the parity toggle rebuild it without invalidating the game ABI.
psp/main.o: $(BOOT_PARITY_CONFIG_STAMP)

# The accepted AnmVmBase::Initialize body is intentionally inline in the
# original-owner TU.  GCC otherwise discards its out-of-line COMDAT even though
# other reconstructed TUs reference it.
src/AsciiManager.o: CXXFLAGS += -fkeep-inline-functions


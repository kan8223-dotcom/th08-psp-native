$(error TH08_PSP_DRAW_PRIORITY_SUBPROFILE must be 0 or 1)
endif

ifeq ($(TH08_PSP_ITEM_UPDATE_SUBPROFILE),1)
ifneq ($(TH08_PSP_PERF_ATTRIBUTION),1)
$(error TH08_PSP_ITEM_UPDATE_SUBPROFILE=1 requires TH08_PSP_PERF_ATTRIBUTION=1)
endif
PSP_ITEM_UPDATE_SUBPROFILE_SRCS := psp/item_update_subprofile.cpp
else ifeq ($(TH08_PSP_ITEM_UPDATE_SUBPROFILE),0)
PSP_ITEM_UPDATE_SUBPROFILE_SRCS :=
else
$(error TH08_PSP_ITEM_UPDATE_SUBPROFILE must be 0 or 1)
endif

ifneq ($(filter-out 0 1,$(TH08_PSP_ITEM_ATAN2_FASTPATH_AUDIT)),)
$(error TH08_PSP_ITEM_ATAN2_FASTPATH_AUDIT must be 0 or 1)
endif
ifneq ($(filter-out 0 1,$(TH08_PSP_ITEM_ATAN2_FASTPATH)),)
$(error TH08_PSP_ITEM_ATAN2_FASTPATH must be 0 or 1)
endif
ifeq ($(TH08_PSP_ITEM_ATAN2_FASTPATH_AUDIT)$(TH08_PSP_ITEM_ATAN2_FASTPATH),11)
$(error TH08_PSP_ITEM_ATAN2_FASTPATH_AUDIT and TH08_PSP_ITEM_ATAN2_FASTPATH are mutually exclusive)
endif
ifeq ($(TH08_PSP_ITEM_ATAN2_FASTPATH_AUDIT),1)
ifneq ($(TH08_PSP_PERF_ATTRIBUTION),1)
$(error TH08_PSP_ITEM_ATAN2_FASTPATH_AUDIT=1 requires TH08_PSP_PERF_ATTRIBUTION=1)

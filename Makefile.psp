endif
ifeq ($(TH08_PSP_ITEM_ATAN2_FASTPATH_AUDIT)$(TH08_PSP_ITEM_ATAN2_FASTPATH),00)
PSP_ITEM_ATAN2_SRCS :=
else
PSP_ITEM_ATAN2_SRCS := psp/item_atan2_audit.cpp
endif

ifneq ($(filter-out 0 1,$(TH08_PSP_ITEM_SINCOS_FASTPATH_AUDIT)),)
$(error TH08_PSP_ITEM_SINCOS_FASTPATH_AUDIT must be 0 or 1)
endif
ifneq ($(filter-out 0 1,$(TH08_PSP_ITEM_SINCOS_FASTPATH)),)
$(error TH08_PSP_ITEM_SINCOS_FASTPATH must be 0 or 1)
endif
ifeq ($(TH08_PSP_ITEM_SINCOS_FASTPATH_AUDIT)$(TH08_PSP_ITEM_SINCOS_FASTPATH),11)
$(error TH08_PSP_ITEM_SINCOS_FASTPATH_AUDIT and TH08_PSP_ITEM_SINCOS_FASTPATH are mutually exclusive)
endif
ifeq ($(TH08_PSP_ITEM_SINCOS_FASTPATH_AUDIT),1)
ifneq ($(TH08_PSP_PERF_ATTRIBUTION),1)
$(error TH08_PSP_ITEM_SINCOS_FASTPATH_AUDIT=1 requires TH08_PSP_PERF_ATTRIBUTION=1)

ifeq ($(TH08_PSP_FLIP_GUARD_COLOR_ONLY),1)
ifneq ($(TH08_PSP_SWAP_NOWAIT),1)
$(error TH08_PSP_FLIP_GUARD_COLOR_ONLY=1 requires TH08_PSP_SWAP_NOWAIT=1)
endif
else ifneq ($(TH08_PSP_FLIP_GUARD_COLOR_ONLY),0)
$(error TH08_PSP_FLIP_GUARD_COLOR_ONLY must be 0 or 1)
endif
ifneq ($(filter-out 0 1,$(TH08_PSP_TICK_GATE_BYPASS)),)
$(error TH08_PSP_TICK_GATE_BYPASS must be 0 or 1)
endif
ifeq ($(TH08_PSP_SWAP_TRIPLE),1)
ifneq ($(TH08_PSP_SWAP_NOWAIT),1)
$(error TH08_PSP_SWAP_TRIPLE=1 requires TH08_PSP_SWAP_NOWAIT=1)
endif
ifeq ($(TH08_PSP_SWAP_ASYNC),1)
$(error TH08_PSP_SWAP_TRIPLE and TH08_PSP_SWAP_ASYNC are mutually exclusive)
endif
PSP_SWAP_TRIPLE_SRCS := psp/swap_triple.cpp
else ifeq ($(TH08_PSP_SWAP_TRIPLE),0)
PSP_SWAP_TRIPLE_SRCS :=
else
$(error TH08_PSP_SWAP_TRIPLE must be 0 or 1)
endif
# Single owner of the sceGeListEnQueue wrap (PERF_ENV observer, SWAP_TRIPLE poll).
ifeq ($(TH08_PSP_PERF_ENV)$(TH08_PSP_SWAP_TRIPLE),00)
PSP_GE_LIST_HOOK_SRCS :=
else
PSP_GE_LIST_HOOK_SRCS := psp/ge_list_hook.cpp
endif
# The module also hosts the display-identity flip guard used by SWAP_NOWAIT.
ifeq ($(TH08_PSP_SWAP_NOWAIT)$(TH08_PSP_SWAP_ASYNC),00)
PSP_SWAP_ASYNC_SRCS :=
else

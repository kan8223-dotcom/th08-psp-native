	-Wl,--require-defined=__malloc_lock -Wl,--require-defined=__malloc_unlock

ifeq ($(TH08_PSP_PERF_ATTRIBUTION),1)
LDFLAGS += -Wl,--wrap=sceGeListSync -Wl,--wrap=sceDisplayWaitVblankStart
endif
ifneq ($(TH08_PSP_PERF_ENV)$(TH08_PSP_SWAP_TRIPLE),00)
# GE queue observer / triple-buffer flip poll: every PSPGL list submission.
LDFLAGS += -Wl,--wrap=sceGeListEnQueue
endif
ifeq ($(TH08_PSP_SOFTFLOAT_CENSUS),1)
SOFTFLOAT_CENSUS_WRAPS := __adddf3 __subdf3 __muldf3 __divdf3 \
	__eqdf2 __nedf2 __gtdf2 __gedf2 __ltdf2 __ledf2 __unorddf2 \
	__extendsfdf2 __truncdfsf2 __fixdfsi __fixunsdfsi __fixdfdi __fixunsdfdi \
	__floatsidf __floatunsidf __floatdidf \
	sin cos atan2 atan sqrt floor ceil fmod pow exp log tan \
	sinf cosf atan2f sqrtf floorf fmodf
LDFLAGS += $(foreach sym,$(SOFTFLOAT_CENSUS_WRAPS),-Wl$(comma)--wrap=$(sym))
endif

# Audit/OFF retain the accepted v3 archive byte-for-byte.  Only the mixed
# product experiment selects the separately fingerprinted archive containing
# the atomic sprite-prefix/indexed-suffix hook.
PSPGL_GE4_SELECTED_ARCHIVE := $(PSPGL_GE4_ARCHIVE)
PSPGL_GE4_SELECTED_ARCHIVE_STAMP := $(PSPGL_GE4_ARCHIVE_STAMP)
ifneq ($(filter 1,$(TH08_PSP_BULLET_MIXED_QUADS_FASTPATH) $(TH08_PSP_ITEM_MIXED_QUADS_FASTPATH)),)
PSPGL_GE4_SELECTED_ARCHIVE := $(PSPGL_GE4_MIXED_ARCHIVE)
PSPGL_GE4_SELECTED_ARCHIVE_STAMP := $(PSPGL_GE4_MIXED_ARCHIVE_STAMP)
endif
ifeq ($(TH08_PSP_ITEM_NATURAL_NATIVE_COPY),1)
PSPGL_GE4_SELECTED_ARCHIVE := $(PSPGL_GE4_INDEXED_COPY_ARCHIVE)
PSPGL_GE4_SELECTED_ARCHIVE_STAMP := $(PSPGL_GE4_INDEXED_COPY_ARCHIVE_STAMP)
endif
ifeq ($(TH08_PSP_PSPGL_STREAM_ARENA),1)
ifneq ($(PSPGL_GE4_SELECTED_ARCHIVE),$(PSPGL_GE4_ARCHIVE))
$(error TH08_PSP_PSPGL_STREAM_ARENA=1 is exclusive with the mixed and indexed-copy archive gates)
endif
PSPGL_GE4_SELECTED_ARCHIVE := $(PSPGL_GE4_STREAM_ARENA_ARCHIVE)
PSPGL_GE4_SELECTED_ARCHIVE_STAMP := $(PSPGL_GE4_STREAM_ARENA_ARCHIVE_STAMP)
endif

# SC-only is an intentional link contract for the first playable target.  Do
# not add me-core, MIST, ME task/audio, or any Media Engine support here.
LIBS := -lSDL2_image -lSDL2_ttf -lSDL2main -lSDL2 $(PSPGL_GE4_SELECTED_ARCHIVE) \
	-lharfbuzz -lfreetype -lbz2 -lpng16 -ljpeg -lz \
	-lpspvram -lpspaudio -lpspvfpu -lpspgum_vfpu -lpspmath \
	-lpspdisplay -lpspgu -lpspge -lpsphprm -lpspctrl -lpsppower \
	-lpspkubridge -lpspsystemctrl_user \
	-lpthread -latomic -lm -lstdc++ -lsupc++

PSPSDK := $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak

# The SDK's generic user-mode defaults add networking even when no network API
# is used. Keep this bootstrap's import surface limited to its actual platform,
# file, controller, display, GE, and power dependencies.
LIBS := $(filter-out -lpspnet -lpspnet_apctl,$(LIBS))

# The upper eDRAM contract lives below the public GL API, so a successful
# compile against headers does not prove that the fork reached the final ELF.
# First validate the frozen archive and source provenance, then gate EBOOT
# packing on symbols, the exact marker, and the link-map archive origin.
$(PSPGL_GE4_ARCHIVE_STAMP): $(PSPGL_GE4_ARCHIVE) $(PSPGL_GE4_PATCH) \
		$(PSPGL_NATIVE_SUBMIT_PATCH) \
		$(PSPGL_GE4_LICENSE) deps/pspgl-ge4/README.md
	@mkdir -p $(dir $@)
	@test "$$(wc -c < "$(PSPGL_GE4_ARCHIVE)")" -eq "$(PSPGL_GE4_ARCHIVE_SIZE)"
	@test "$$(sha256sum "$(PSPGL_GE4_ARCHIVE)" | awk '{print $$1}')" = "$(PSPGL_GE4_ARCHIVE_SHA256)"
	@test "$$(sha256sum "$(PSPGL_GE4_PATCH)" | awk '{print $$1}')" = "$(PSPGL_GE4_PATCH_SHA256)"
	@test "$$(sha256sum "$(PSPGL_NATIVE_SUBMIT_PATCH)" | awk '{print $$1}')" = "$(PSPGL_NATIVE_SUBMIT_PATCH_SHA256)"
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_texobj_promote_upper$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_ARCHIVE) | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_ge4_fork_marker$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_indexed_triangles$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_sprite_pairs_copy$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_ARCHIVE) | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_native_submit_marker$$'
	@strings $(PSPGL_GE4_ARCHIVE) | grep -Fxq '$(PSPGL_GE4_MARKER)'
	@strings $(PSPGL_GE4_ARCHIVE) | grep -Fxq '$(PSPGL_NATIVE_SUBMIT_MARKER)'
	@touch $@

$(PSPGL_GE4_STREAM_ARENA_ARCHIVE_STAMP): \
		$(PSPGL_GE4_STREAM_ARENA_ARCHIVE) \
		$(PSPGL_STREAM_ARENA_PATCH) $(PSPGL_GE4_ARCHIVE_STAMP) \
		$(PSPGL_GE4_LICENSE) deps/pspgl-ge4/README.md
	@mkdir -p $(dir $@)
	@test "$$(wc -c < "$(PSPGL_GE4_STREAM_ARENA_ARCHIVE)")" -eq "$(PSPGL_GE4_STREAM_ARENA_ARCHIVE_SIZE)"
	@test "$$(sha256sum "$(PSPGL_GE4_STREAM_ARENA_ARCHIVE)" | awk '{print $$1}')" = "$(PSPGL_GE4_STREAM_ARENA_ARCHIVE_SHA256)"
	@test "$$(sha256sum "$(PSPGL_STREAM_ARENA_PATCH)" | awk '{print $$1}')" = "$(PSPGL_STREAM_ARENA_PATCH_SHA256)"
	@test "$$(sha256sum "$(PSPGL_GE4_LICENSE)" | awk '{print $$1}')" = "$(PSPGL_GE4_LICENSE_SHA256)"
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_texobj_promote_upper$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_ge4_fork_marker$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_indexed_triangles$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_sprite_pairs_copy$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_native_submit_marker$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_stream_arena_install$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_stream_arena_begin_frame$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_stream_arena_marker$$'
	@strings $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | grep -Fxq '$(PSPGL_GE4_MARKER)'
	@strings $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | grep -Fxq '$(PSPGL_NATIVE_SUBMIT_MARKER)'
	@strings $(PSPGL_GE4_STREAM_ARENA_ARCHIVE) | grep -Fxq '$(PSPGL_STREAM_ARENA_MARKER)'
	@touch $@

$(PSPGL_GE4_MIXED_ARCHIVE_STAMP): $(PSPGL_GE4_MIXED_ARCHIVE) \
		$(PSPGL_NATIVE_MIXED_PATCH) $(PSPGL_GE4_ARCHIVE_STAMP) \
		$(PSPGL_GE4_LICENSE) deps/pspgl-ge4/README.md
	@mkdir -p $(dir $@)
	@test "$$(wc -c < "$(PSPGL_GE4_MIXED_ARCHIVE)")" -eq "$(PSPGL_GE4_MIXED_ARCHIVE_SIZE)"
	@test "$$(sha256sum "$(PSPGL_GE4_MIXED_ARCHIVE)" | awk '{print $$1}')" = "$(PSPGL_GE4_MIXED_ARCHIVE_SHA256)"
	@test "$$(sha256sum "$(PSPGL_NATIVE_MIXED_PATCH)" | awk '{print $$1}')" = "$(PSPGL_NATIVE_MIXED_PATCH_SHA256)"
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_MIXED_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_texobj_promote_upper$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_MIXED_ARCHIVE) | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_ge4_fork_marker$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_MIXED_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_indexed_triangles$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_MIXED_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_sprite_pairs_copy$$'
	@$(PSPDEV)/bin/psp-nm -S -g --defined-only $(PSPGL_GE4_MIXED_ARCHIVE) | \
		grep -Eq '^[[:xdigit:]]+[[:space:]]+000002d8[[:space:]]+T[[:space:]]+__pspgl_th08_draw_native_mixed_quads$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_MIXED_ARCHIVE) | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_native_submit_marker$$'
	@strings $(PSPGL_GE4_MIXED_ARCHIVE) | grep -Fxq '$(PSPGL_GE4_MARKER)'
	@strings $(PSPGL_GE4_MIXED_ARCHIVE) | grep -Fxq '$(PSPGL_NATIVE_SUBMIT_MARKER)'
	@touch $@

$(PSPGL_GE4_INDEXED_COPY_ARCHIVE_STAMP): \
		$(PSPGL_GE4_INDEXED_COPY_ARCHIVE) \
		$(PSPGL_NATIVE_INDEXED_COPY_PATCH) $(PSPGL_GE4_ARCHIVE_STAMP) \
		$(PSPGL_GE4_LICENSE) deps/pspgl-ge4/README.md
	@mkdir -p $(dir $@)
	@test "$$(wc -c < "$(PSPGL_GE4_INDEXED_COPY_ARCHIVE)")" -eq "$(PSPGL_GE4_INDEXED_COPY_ARCHIVE_SIZE)"
	@test "$$(sha256sum "$(PSPGL_GE4_INDEXED_COPY_ARCHIVE)" | awk '{print $$1}')" = "$(PSPGL_GE4_INDEXED_COPY_ARCHIVE_SHA256)"
	@test "$$(sha256sum "$(PSPGL_NATIVE_INDEXED_COPY_PATCH)" | awk '{print $$1}')" = "$(PSPGL_NATIVE_INDEXED_COPY_PATCH_SHA256)"
	@test "$$(sha256sum "$(PSPGL_GE4_LICENSE)" | awk '{print $$1}')" = "$(PSPGL_GE4_LICENSE_SHA256)"
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_INDEXED_COPY_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_texobj_promote_upper$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_INDEXED_COPY_ARCHIVE) | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_ge4_fork_marker$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_INDEXED_COPY_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_indexed_triangles$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(PSPGL_GE4_INDEXED_COPY_ARCHIVE) | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_sprite_pairs_copy$$'
	@$(PSPDEV)/bin/psp-nm -S -g --defined-only $(PSPGL_GE4_INDEXED_COPY_ARCHIVE) | \
		grep -Eq '^[[:xdigit:]]+[[:space:]]+000001b4[[:space:]]+T[[:space:]]+__pspgl_th08_draw_native_indexed_quads_copy$$'
	@$(PSPDEV)/bin/psp-nm -S -g --defined-only $(PSPGL_GE4_INDEXED_COPY_ARCHIVE) | \
		grep -Eq '^[[:xdigit:]]+[[:space:]]+0000006f[[:space:]]+R[[:space:]]+__pspgl_th08_native_indexed_copy_marker$$'
	@strings $(PSPGL_GE4_INDEXED_COPY_ARCHIVE) | grep -Fxq '$(PSPGL_GE4_MARKER)'
	@strings $(PSPGL_GE4_INDEXED_COPY_ARCHIVE) | grep -Fxq '$(PSPGL_NATIVE_SUBMIT_MARKER)'
	@strings $(PSPGL_GE4_INDEXED_COPY_ARCHIVE) | grep -Fxq '$(PSPGL_NATIVE_INDEXED_COPY_MARKER)'
	@touch $@

$(TARGET).elf: | $(PSPGL_GE4_SELECTED_ARCHIVE_STAMP)

$(PSPGL_GE4_LINK_STAMP): $(TARGET).elf $(PSPGL_GE4_SELECTED_ARCHIVE_STAMP)
	@mkdir -p $(dir $@)
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(TARGET).elf | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_texobj_promote_upper$$'
	@$(PSPDEV)/bin/psp-nm -g --defined-only $(TARGET).elf | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_ge4_fork_marker$$'
	@strings $(TARGET).elf | grep -Fxq '$(PSPGL_GE4_MARKER)'
	@if test "$(TH08_PSP_BULLET_DIRECT_GE)" = "1" || \
	   test "$(TH08_PSP_ITEM_DIRECT_GE)" = "1"; then \
		$(PSPDEV)/bin/psp-nm -g --defined-only $(TARGET).elf | \
		grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_indexed_triangles$$'; \
	fi
	@if test "$(TH08_PSP_SCORE_POPUP_NATIVE_GE)" = "1"; then \
		$(PSPDEV)/bin/psp-nm -g --defined-only $(TARGET).elf | \
			grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_sprite_pairs_copy$$'; \
	fi
	@if test "$(TH08_PSP_EFFECT_SPRITE_PAIR_FASTPATH)" = "1"; then \
		$(PSPDEV)/bin/psp-nm -g --defined-only $(TARGET).elf | \
			grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_sprite_pairs_copy$$'; \
	fi
	@if test "$(TH08_PSP_ITEM_TIME_DRAW_PAIR_FASTPATH)" = "1"; then \
		$(PSPDEV)/bin/psp-nm -g --defined-only $(TARGET).elf | \
			grep -Eq '[[:space:]]T[[:space:]]+__pspgl_th08_draw_native_sprite_pairs_copy$$'; \
	fi
	@if test "$(TH08_PSP_ITEM_NATURAL_NATIVE_COPY)" = "1"; then \
		$(PSPDEV)/bin/psp-nm -S -g --defined-only $(TARGET).elf | \
			grep -Eq '^[[:xdigit:]]+[[:space:]]+000001b4[[:space:]]+T[[:space:]]+__pspgl_th08_draw_native_indexed_quads_copy$$'; \
		$(PSPDEV)/bin/psp-nm -S -g --defined-only $(TARGET).elf | \
			grep -Eq '^[[:xdigit:]]+[[:space:]]+0000006f[[:space:]]+R[[:space:]]+__pspgl_th08_native_indexed_copy_marker$$'; \
		strings $(TARGET).elf | grep -Fxq '$(PSPGL_NATIVE_INDEXED_COPY_MARKER)'; \
	fi
	@if test "$(TH08_PSP_BULLET_DIRECT_GE)" = "1" || \
	   test "$(TH08_PSP_ITEM_DIRECT_GE)" = "1" || \
	   test "$(TH08_PSP_ITEM_MIXED_QUADS_FASTPATH)" = "1" || \
	   test "$(TH08_PSP_SCORE_POPUP_NATIVE_GE)" = "1" || \
	   test "$(TH08_PSP_ITEM_TIME_DRAW_PAIR_FASTPATH)" = "1" || \
	   test "$(TH08_PSP_EFFECT_SPRITE_PAIR_FASTPATH)" = "1" || \
	   test "$(TH08_PSP_ITEM_NATURAL_NATIVE_COPY)" = "1"; then \
		$(PSPDEV)/bin/psp-nm -g --defined-only $(TARGET).elf | \
		grep -Eq '[[:space:]]R[[:space:]]+__pspgl_th08_native_submit_marker$$'; \
		strings $(TARGET).elf | grep -Fxq '$(PSPGL_NATIVE_SUBMIT_MARKER)'; \
	fi
	@if test "$(TH08_PSP_BULLET_MIXED_QUADS_FASTPATH)" = "1" || \
	   test "$(TH08_PSP_ITEM_MIXED_QUADS_FASTPATH)" = "1"; then \
		$(PSPDEV)/bin/psp-nm -S -g --defined-only $(TARGET).elf | \
		grep -Eq '^[[:xdigit:]]+[[:space:]]+000002d8[[:space:]]+T[[:space:]]+__pspgl_th08_draw_native_mixed_quads$$'; \
	fi
	@grep -Fq '$(PSPGL_GE4_SELECTED_ARCHIVE)' TH08PSP.map
	@touch $@

.PHONY: FORCE_GE4_PROVEN_PRX
FORCE_GE4_PROVEN_PRX:

# Never package a rebuilt or similarly named wrapper.  The game-side bridge is
# tied to the exact TH07 hardware-proven binary ABI and rejects every platform
# which does not satisfy the runtime model/base/HW-size/visible-size gates.
ifeq ($(TH08_PSP_SLIMPLUS_GE4),1)
$(GE4_PROVEN_PRX): FORCE_GE4_PROVEN_PRX $(GE4_PROVEN_PRX_SOURCE) $(GE4_SLIMPLUS_PRX_BUILDER)
	python3 "$(GE4_SLIMPLUS_PRX_BUILDER)" \
		--input "$(GE4_PROVEN_PRX_SOURCE)" --output "$@"
	@test "$$(wc -c < "$@")" -eq "$(GE4_PROVEN_PRX_SIZE)"
	@test "$$(sha256sum "$@" | awk '{print $$1}')" = "$(GE4_PROVEN_PRX_SHA256)"
else
$(GE4_PROVEN_PRX): FORCE_GE4_PROVEN_PRX $(GE4_PROVEN_PRX_SOURCE)
	@test "$$(wc -c < "$(GE4_PROVEN_PRX_SOURCE)")" -eq "$(GE4_PROVEN_PRX_SIZE)"
	@test "$$(sha256sum "$(GE4_PROVEN_PRX_SOURCE)" | awk '{print $$1}')" = "$(GE4_PROVEN_PRX_SHA256)"
	cp "$(GE4_PROVEN_PRX_SOURCE)" "$@"
	@test "$$(wc -c < "$@")" -eq "$(GE4_PROVEN_PRX_SIZE)"
	@test "$$(sha256sum "$@" | awk '{print $$1}')" = "$(GE4_PROVEN_PRX_SHA256)"
endif

$(GENERATED_I18N): config/i18n.csv scripts/generate_i18n.py
	@mkdir -p $(GENERATED_DIR)
	python3 scripts/generate_i18n.py -o $@ --shift-jis $<


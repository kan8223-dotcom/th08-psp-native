CXXFLAGS += -DTH08_PSP_ANM_SCRATCH_COMPACT=1
endif
ifeq ($(TH08_PSP_ANM_TEXTURE_16BIT),1)
CXXFLAGS += -DTH08_PSP_ANM_TEXTURE_16BIT=1
endif
ifeq ($(TH08_PSP_DIALOGUE_SNAPSHOT_AT_BACKGROUND),1)
CXXFLAGS += -DTH08_PSP_DIALOGUE_SNAPSHOT_AT_BACKGROUND=1
endif

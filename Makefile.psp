endif

ifeq ($(TH08_PSP_TH07_BOOT_PARITY),1)
CXXFLAGS += -DTH08_PSP_TH07_BOOT_PARITY=1
else ifeq ($(TH08_PSP_TH07_BOOT_PARITY),0)
CXXFLAGS += -DTH08_PSP_TH07_BOOT_PARITY=0
else
$(error TH08_PSP_TH07_BOOT_PARITY must be 0 or 1)
endif

ifeq ($(TH08_PSP_BULLET_FASTPATH),1)
CXXFLAGS += -DTH08_PSP_BULLET_FASTPATH=1
else ifneq ($(TH08_PSP_BULLET_FASTPATH),0)
$(error TH08_PSP_BULLET_FASTPATH must be 0 or 1)
endif

ifeq ($(TH08_PSP_BULLET_LIVE_ENUM),1)
ifneq ($(TH08_PSP_BULLET_FASTPATH),1)
$(error TH08_PSP_BULLET_LIVE_ENUM=1 requires TH08_PSP_BULLET_FASTPATH=1)
endif
CXXFLAGS += -DTH08_PSP_BULLET_LIVE_ENUM=1
else ifneq ($(TH08_PSP_BULLET_LIVE_ENUM),0)
$(error TH08_PSP_BULLET_LIVE_ENUM must be 0 or 1)
endif

ifeq ($(TH08_PSP_BULLET_TRANSFORM_AUDIT),1)
CXXFLAGS += -DTH08_PSP_BULLET_TRANSFORM_AUDIT=1
else ifneq ($(TH08_PSP_BULLET_TRANSFORM_AUDIT),0)
$(error TH08_PSP_BULLET_TRANSFORM_AUDIT must be 0 or 1)
endif

ifeq ($(TH08_PSP_BULLET_TRANSFORM_TERMINAL_FASTPATH),1)
ifneq ($(TH08_PSP_BULLET_FASTPATH),1)
$(error TH08_PSP_BULLET_TRANSFORM_TERMINAL_FASTPATH=1 requires TH08_PSP_BULLET_FASTPATH=1)

ifneq ($(filter-out 0 1,$(TH08_PSP_AUDIO_FIXED_CURSOR_AUDIT)),)
$(error TH08_PSP_AUDIO_FIXED_CURSOR_AUDIT must be 0 or 1)
endif
ifneq ($(filter-out 0 1,$(TH08_PSP_AUDIO_FIXED_CURSOR)),)

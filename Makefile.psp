CXXFLAGS += -DTH08_PSP_GUI_BORDER_REPLAY_AUDIT=1
endif
ifeq ($(TH08_PSP_GUI_BORDER_REPLAY),1)
CXXFLAGS += -DTH08_PSP_GUI_BORDER_REPLAY=1
endif
# The flip thread reads PSPGL's surface through the vendored internal headers.
psp/swap_async.o: CXXFLAGS += -Ideps/pspgl-ge4/include
psp/swap_triple.o: CXXFLAGS += -Ideps/pspgl-ge4/include
# The double-float atan2 and sin/cos rely on exact IEEE binary32 add/mul
# rounding.  Allegrex has no fused multiply-add, but pin the contract on the
# objects that instantiate the headers so a toolchain change cannot silently fuse.
src/ItemManager.o psp/item_atan2_audit.o psp/item_sincos_audit.o: CXXFLAGS += -ffp-contract=off
psp/trig_df_fastpath.o: CXXFLAGS += -ffp-contract=off

ifeq ($(TH08_PSP_SLIMPLUS_GE4),1)
CXXFLAGS += -DTH08_PSP_SLIMPLUS_GE4=1
endif

ifeq ($(TH08_REPLAY_SYNC_AUDIT),1)
CXXFLAGS += -DTH08_REPLAY_SYNC_AUDIT=1
else ifneq ($(TH08_REPLAY_SYNC_AUDIT),0)
$(error TH08_REPLAY_SYNC_AUDIT must be 0 or 1)
endif

ifeq ($(TH08_PSP_RENDER_VFPU),1)
CXXFLAGS += -DTH08_PSP_RENDER_VFPU=1
else ifneq ($(TH08_PSP_RENDER_VFPU),0)

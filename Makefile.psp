	$(FONT_STREAM_CACHE_CONFIG_STAMPS)
SDL_CFLAGS := $(shell psp-pkg-config --cflags sdl2 SDL2_image SDL2_ttf)

# Heap-geometry telemetry is pinned to PSPSDK/newlib 4.5.0 classic
# dlmalloc: 16-byte request rounding and final-ELF __malloc_av_ size 0x408.
# Re-audit those facts before changing either contract define.
CXXFLAGS := -std=gnu++17 -O2 -G0 -march=allegrex -mtune=allegrex \
	-Wall -Wextra -Wconversion -Wshadow -Wno-unused-parameter \
	-Wno-write-strings -fpermissive \
	-fno-exceptions -fno-rtti -fno-pic -MMD -MP \
	-DPSP -DTH08_PSP_PORT=1 -DTH08_PSP_SC_ONLY=1 -DTH08_PSP_STAGE_POOL_ARENA=1 \
	-DTH08_PSP_RUNTIME_TELEMETRY=$(TH08_PSP_RUNTIME_TELEMETRY) \
	-DTH08_PSP_PERF_ATTRIBUTION=$(TH08_PSP_PERF_ATTRIBUTION) \
	-DTH08_PSP_RENDER_CADENCE_INITIAL_MODE=$(TH08_PSP_RENDER_CADENCE_INITIAL_MODE) \
	-DTH08_PSP_NEWLIB_4_5_0_DLMALLOC=1 -DTH08_PSP_NEWLIB_MALLOC_ALIGNMENT=16 \
	-DTH08_MODERN_PORT -DTH08_MODERN_LINUX -DWIN32_LEAN_AND_MEAN \
	-DSDL_MAIN_HANDLED \
	-DTH08_UPSTREAM_COMMIT=\"$(TH08_UPSTREAM_COMMIT)\" \
	-DTH08_ORACLE_COMMIT=\"$(TH08_ORACLE_COMMIT)\" \
	-DTH07_BACKEND_COMMIT=\"$(TH07_BACKEND_COMMIT)\" \
	-DTH07_GE4_BRIDGE_COMMIT=\"$(TH07_GE4_BRIDGE_COMMIT)\" \
	-DTH08_PSP_BUILD_ID=\"$(TH08_PSP_BUILD_ID)\" \
	-Ipsp -Isrc -I$(GENERATED_DIR) -Isrc/modern/linux/include \
	-include src/modern/linux/linux_compat.hpp $(SDL_CFLAGS)

ifeq ($(TH08_PSP_DRAW_PRIORITY_SUBPROFILE),1)
CXXFLAGS += -DTH08_PSP_DRAW_PRIORITY_SUBPROFILE=1
endif

ifeq ($(TH08_PSP_ITEM_UPDATE_SUBPROFILE),1)

export PATH := /usr/local/pspdev/bin:$(PATH)
export PSPDEV := /usr/local/pspdev

TARGET := TH08PSP

# Diagnostic builds retain the full frame/memory/audio observers.  Product
# candidates set this to 0, which removes their translation units and replaces
# the tracked allocator with an ownership-only implementation.
TH08_PSP_RUNTIME_TELEMETRY ?= 1

# Default-off attribution probe for hardware-only performance diagnosis.  It
# is independent of the heavyweight runtime telemetry switch, keeps only
# fixed aggregate counters, and writes one buffered line per 600 stage ticks.
# A zero build does not compile the observer or wrap GE/display wait symbols.
TH08_PSP_PERF_ATTRIBUTION ?= 0

# Default-off 1/16 presented-frame sampler which decomposes DrawChain by its
# canonical priority callbacks.  It is a child of PERF_ATTRIBUTION so both
# reports share exactly the same 600-stage-tick window boundaries.
TH08_PSP_DRAW_PRIORITY_SUBPROFILE ?= 0

# Default-off Item update sub-profile.  Every simulation tick it counts the
# whole active item population by state/branch and times a rotating 1-of-32
# list-position sample (whole/autocollect/collision/script).  It is a child of
# PERF_ATTRIBUTION and emits one ITEM_UPD V1 line per parent window.
TH08_PSP_ITEM_UPDATE_SUBPROFILE ?= 0

# Item autocollect atan2 fast path.  AUDIT keeps the canonical
# Player::AngleToPoint result and shadow-runs the double-float fast path on
# every call (bit compare, raw-delta/angle repeat rates, sampled timing).
# The product switch uses the fast path when it accepts and falls back to the
# canonical call otherwise.  Both default OFF and are mutually exclusive.
TH08_PSP_ITEM_ATAN2_FASTPATH_AUDIT ?= 0
TH08_PSP_ITEM_ATAN2_FASTPATH ?= 0

# Item autocollect velocity sin/cos-multiply fast path (same contract as the
# atan2 switches): AUDIT shadow-compares against FromAngleMagnitude, the
# product switch substitutes identical binary32 products when accepted.
TH08_PSP_ITEM_SINCOS_FASTPATH_AUDIT ?= 0
TH08_PSP_ITEM_SINCOS_FASTPATH ?= 0

# Default-off soft-float census: linker-wraps the libgcc binary64 helpers and
# the libm entry points to count calls per PERF_ATTR phase and per operation
# class (one SOFTFLOAT V1 line per parent window).  Child of PERF_ATTRIBUTION.
TH08_PSP_SOFTFLOAT_CENSUS ?= 0

# SC audio mixer resampling cursor.  AUDIT keeps the canonical binary64 cursor
# and shadow-runs the exact fixed-point cursor per output frame (frame index,
# wrap and final cursor compared); the product switch uses the fixed-point
# cursor whenever 44100 / rate is a power of two and falls back otherwise.
# The PC oracle build never sees these switches.  Mutually exclusive.
TH08_PSP_AUDIO_FIXED_CURSOR_AUDIT ?= 0
TH08_PSP_AUDIO_FIXED_CURSOR ?= 0

# x87-compatible trig helpers (ZunMath.hpp) on the Item double-float fast
# paths: FromAngleMagnitude/FromRotatedVec2, X87CompatibleSin/Cos(+Mul) and
# X87CompatibleAtan2 for every caller (Bullet/Enemy/ECL/Player/Effect).
# AUDIT shadow-compares, the product switch replaces accepted calls.
# Mutually exclusive, default OFF; the PC oracle build never sees them.
TH08_PSP_TRIG_DF_FASTPATH_AUDIT ?= 0
TH08_PSP_TRIG_DF_FASTPATH ?= 0

# Execution-environment record per PERF_ATTR window (R-038): effective CPU/bus
# clock at window start/end, a fresh timer calibration, main-thread kernel run
# clocks and preemption counts, and sceGeListSync waits reached outside the
# swap context attributed to the innermost phase (and, with the draw-priority
# sub-profile, to the running draw priority).  Child of PERF_ATTRIBUTION.
TH08_PSP_PERF_ENV ?= 0

# Present without the PSPGL VBlank wait (swap interval 0); the cadence wait
# owns the 60 Hz pacing and the compat device waits for the pending flip before
# the next frame's first GE write.  Default OFF.
TH08_PSP_SWAP_NOWAIT ?= 0

# Asynchronous flip thread on top of SWAP_NOWAIT: Present hands the finished
# buffer to a flip thread (sceGeDrawSync + sceDisplaySetFrameBuf) so the GE
# tail overlaps the next simulation ticks.  Requires SWAP_NOWAIT=1.  Default OFF.
TH08_PSP_SWAP_ASYNC ?= 0

# Child of SWAP_NOWAIT: apply the flip guard only before GE writes that reach
# the colour buffer (BeginScene, Draw, DrawIndexed, Clear with TARGET or
# STENCIL).  GameManager's depth-only Clear inside the calc chain no longer
# waits for the display to show the previous frame; the wait moves to the draw
# chain's first colour write, which the simulation ticks in between have
# usually already covered.  Requires SWAP_NOWAIT=1.  Default OFF.
TH08_PSP_FLIP_GUARD_COLOR_ONLY ?= 0

# Run a simulation tick on every Render call instead of spinning on the retail
# 1/60 wall-clock gate; the PSP render cadence (VBlank) paces the loop.
# Timing only: input, RNG and replay bytes are unchanged.  Default OFF.
TH08_PSP_TICK_GATE_BYPASS ?= 0

# Diagnostic-only PSP Go storage activity lamp.  The build gate is default
# OFF; an ON build still enables at runtime only when kuKernelGetModel()==4.
# Ordinary/recent syscalls draw amber and >=100 ms syscalls latch red after
# return, making ef0 driver stalls attributable without changing I/O policy.
TH08_PSP_GO_IO_LAMP ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_GO_IO_LAMP)),)
$(error TH08_PSP_GO_IO_LAMP must be 0 or 1)
endif
# Serialize every storage transaction (and the SDL_ttf font stream) on one
# recursive kernel mutex; runtime-enabled on PSP Go only (R-051).  Default OFF.
TH08_PSP_IO_SERIALIZE ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_IO_SERIALIZE)),)
$(error TH08_PSP_IO_SERIALIZE must be 0 or 1)
endif
ifeq ($(TH08_PSP_IO_SERIALIZE),1)
ifneq ($(TH08_PSP_GO_IO_LAMP),1)
$(error TH08_PSP_IO_SERIALIZE=1 requires TH08_PSP_GO_IO_LAMP=1)
endif
endif
# Stage ef0 transfers whose user buffer lies above 0x0A000000 through a low
# 64 KiB buffer (R-051 candidate).  Requires TH08_PSP_IO_SERIALIZE.  Default OFF.
TH08_PSP_IO_BOUNCE_HIGH ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_IO_BOUNCE_HIGH)),)
$(error TH08_PSP_IO_BOUNCE_HIGH must be 0 or 1)
endif
# Serve the SDL_ttf font stream from a 4 KiB block cache (R-051: the FreeType
# tiny-read bursts precede every ef0 stall).  Requires TH08_PSP_IO_SERIALIZE.
TH08_PSP_FONT_STREAM_CACHE ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_FONT_STREAM_CACHE)),)
$(error TH08_PSP_FONT_STREAM_CACHE must be 0 or 1)
endif
# Development aid: start a new game at the stage named in TH08PSP_DEBUG_STAGE.txt.
TH08_PSP_DEBUG_START_STAGE ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_DEBUG_START_STAGE)),)
$(error TH08_PSP_DEBUG_START_STAGE must be 0 or 1)
endif
# Stage scripts (.ecl/.std/.msg) from the renderer arena instead of the heap (R-056).
TH08_PSP_STAGE_SCRIPT_ARENA ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_STAGE_SCRIPT_ARENA)),)
$(error TH08_PSP_STAGE_SCRIPT_ARENA must be 0 or 1)
endif
# ANM phase scratch sized for stages 1-6/Extra (3 MiB) instead of the Last
# Word effect sets (8.25 MiB); reclaims ~5 MiB of heap (R-056).  Default OFF.
TH08_PSP_ANM_SCRATCH_COMPACT ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_ANM_SCRATCH_COMPACT)),)
$(error TH08_PSP_ANM_SCRATCH_COMPACT must be 0 or 1)
endif
TH08_PSP_ANM_TEXTURE_16BIT ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_ANM_TEXTURE_16BIT)),)
$(error TH08_PSP_ANM_TEXTURE_16BIT must be 0 or 1)
endif
# Redraw the dialogue background snapshot from Background::OnDraw instead of
# BeginScene (R-045).  Default OFF.
TH08_PSP_DIALOGUE_SNAPSHOT_AT_BACKGROUND ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_DIALOGUE_SNAPSHOT_AT_BACKGROUND)),)
$(error TH08_PSP_DIALOGUE_SNAPSHOT_AT_BACKGROUND must be 0 or 1)
endif
# Keep drawing the stage background during dialogue instead of freezing the
# dialogue snapshot (deliberate deviation).  Default OFF.
TH08_PSP_DIALOGUE_LIVE_BACKGROUND ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_DIALOGUE_LIVE_BACKGROUND)),)
$(error TH08_PSP_DIALOGUE_LIVE_BACKGROUND must be 0 or 1)
endif

ifeq ($(TH08_PSP_GO_IO_LAMP),1)
PSP_GO_IO_LAMP_SRCS := psp/io_activity_lamp.cpp
else
PSP_GO_IO_LAMP_SRCS :=
endif

# Third colour buffer on top of SWAP_NOWAIT: Present rotates buffers without
# waiting for the GE, the flip is issued from the main thread once the frame's
# display lists are done (list-submission hook / loop head / next Present), and
# the next frame draws into a buffer that is neither displayed nor pending.
# Requires SWAP_NOWAIT=1, exclusive with SWAP_ASYNC.  Default OFF.
TH08_PSP_SWAP_TRIPLE ?= 0

# HUD border tile replay (Gui::DrawGameScene): AUDIT keeps the canonical
# loops and compares their vertices with the stored record; the product switch
# replays the record when the sprite/manager key is unchanged.  Exclusive.
TH08_PSP_GUI_BORDER_REPLAY_AUDIT ?= 0
TH08_PSP_GUI_BORDER_REPLAY ?= 0

# Product bullet collision negative gate proven by TH08_PSP_BULLET_COLLISION_GATE_AUDIT
# (Codex handoff section 10): a bullet strictly separated from the canonical
# first-call box with an empty cancel set skips the graze/lethal scan and
# reproduces bulletCancelItemType=6.  Requires PLAYER_SCAN_SIDECAR=1; exclusive
# with the audit.  Default OFF.
TH08_PSP_BULLET_COLLISION_GATE ?= 0

# Shadow audit of the Effect occupancy sidecar (canonical visits, bit compared).
# Exclusive with TH08_PSP_EFFECT_OCCUPANCY_FASTPATH.  Default OFF.
TH08_PSP_EFFECT_OCCUPANCY_AUDIT ?= 0
comma := ,

# Product builds retain the established 60-present default (mode 0).
# Hardware diagnostics may opt into mode 2 (20 presents) or mode 1 (30
# presents, the 2026-09-03 target) so a run starts directly at that cadence
# without requiring an uncertain SELECT press.
TH08_PSP_RENDER_CADENCE_INITIAL_MODE ?= 0
ifneq ($(filter-out 0 1 2,$(TH08_PSP_RENDER_CADENCE_INITIAL_MODE)),)
$(error TH08_PSP_RENDER_CADENCE_INITIAL_MODE must be 0, 1 or 2)
endif

# The frozen TH07 wrapper was originally model-3-only. TH07 later proved on
# real PSP Go hardware that changing only that wrapper predicate to Slim+
# (model >= 1), while retaining the physical-size/base/visible-size/readback
# gates, safely exposes the same 4 MiB GE aperture. Model 0 keeps the ordinary
# 2 MiB fallback.
TH08_PSP_SLIMPLUS_GE4 ?= 1

ifeq ($(TH08_PSP_RUNTIME_TELEMETRY),1)
PSP_RUNTIME_TELEMETRY_SRCS := \
	psp/audio_telemetry.cpp \
	psp/memory_telemetry.cpp \
	psp/radial_trail_telemetry.cpp \
	psp/render_perf_telemetry.cpp
else ifeq ($(TH08_PSP_RUNTIME_TELEMETRY),0)
PSP_RUNTIME_TELEMETRY_SRCS := psp/memory_runtime.cpp
else
$(error TH08_PSP_RUNTIME_TELEMETRY must be 0 or 1)
endif

ifeq ($(TH08_PSP_PERF_ATTRIBUTION),1)
PSP_PERF_ATTRIBUTION_SRCS := psp/perf_attribution.cpp
else ifeq ($(TH08_PSP_PERF_ATTRIBUTION),0)
PSP_PERF_ATTRIBUTION_SRCS :=
else
$(error TH08_PSP_PERF_ATTRIBUTION must be 0 or 1)
endif

ifeq ($(TH08_PSP_DRAW_PRIORITY_SUBPROFILE),1)
ifneq ($(TH08_PSP_PERF_ATTRIBUTION),1)
$(error TH08_PSP_DRAW_PRIORITY_SUBPROFILE=1 requires TH08_PSP_PERF_ATTRIBUTION=1)

$(error TH08_PSP_EFFECT_OCCUPANCY_AUDIT must be 0 or 1)
endif

# Keep the complete authored game closure in one explicit list.  The PSP host
# enters the same WinMain/game loop as the portable desktop target once the
# original 1.00d archives have passed the bootstrap probes.
TH08_GAME_SRCS := \
	src/AnmManager.cpp \
	src/AsciiManager.cpp \
	src/AsciiManagerBossMarker.cpp \
	src/AsciiManagerGauge.cpp \
	src/AsciiManagerGuiMode.cpp \
	src/AsciiManagerScale.cpp \
	src/Background.cpp \
	src/BulletManager.cpp \
	src/EclDependencies.cpp \
	src/EclExIns.cpp \
	src/EclGlobals.cpp \
	src/EclHelpers.cpp \
	src/EclManager.cpp \
	src/EclOperandsFloat.cpp \
	src/EclOperandsInt.cpp \
	src/EclRun.cpp \
	src/EffectManager.cpp \
	src/Ending.cpp \
	src/EnemyManager.cpp \
	src/EnemyManagerUpdate.cpp \
	src/EnemyTimeline.cpp \
	src/GameManager.cpp \
	src/Global.cpp \
	src/Gui.cpp \
	src/ItemManager.cpp \
	src/Midi.cpp \
	src/MusicRoom.cpp \
	src/Player.cpp \
	src/PlayerBomb.cpp \
	src/ReplaySyncAudit.cpp \
	src/ReplayManager.cpp \
	src/ResultScreen.cpp \
	src/ScoreDat.cpp \
	src/ScreenEffect.cpp \
	src/SoundPlayer.cpp \
	src/Spellcard.cpp \
	src/Supervisor.cpp \
	src/TextHelper.cpp \
	src/TitleScreen.cpp \
	src/main.cpp \

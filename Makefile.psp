PSP_DRAW_PRIORITY_SUBPROFILE_SRCS := psp/draw_priority_subprofile.cpp
else ifeq ($(TH08_PSP_DRAW_PRIORITY_SUBPROFILE),0)
PSP_DRAW_PRIORITY_SUBPROFILE_SRCS :=

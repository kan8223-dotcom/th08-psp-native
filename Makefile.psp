endif
ifeq ($(TH08_PSP_EFFECT_OCCUPANCY_FASTPATH),1)
CXXFLAGS += -DTH08_PSP_EFFECT_OCCUPANCY_FASTPATH=1
else ifneq ($(TH08_PSP_EFFECT_OCCUPANCY_FASTPATH),0)
$(error TH08_PSP_EFFECT_OCCUPANCY_FASTPATH must be 0 or 1)
endif

ifeq ($(TH08_PSP_EFFECT_SPRITE_PAIR_AUDIT),1)
ifeq ($(TH08_PSP_EFFECT_INDEXED_QUADS),1)
$(error TH08_PSP_EFFECT_SPRITE_PAIR_AUDIT requires the canonical six-vertex Effect path)
endif
CXXFLAGS += -DTH08_PSP_EFFECT_SPRITE_PAIR_AUDIT=1
else ifneq ($(TH08_PSP_EFFECT_SPRITE_PAIR_AUDIT),0)
$(error TH08_PSP_EFFECT_SPRITE_PAIR_AUDIT must be 0 or 1)
endif

ifeq ($(TH08_PSP_EFFECT_SPRITE_PAIR_FASTPATH),1)
ifeq ($(TH08_PSP_EFFECT_SPRITE_PAIR_AUDIT),1)
$(error TH08_PSP_EFFECT_SPRITE_PAIR_FASTPATH and TH08_PSP_EFFECT_SPRITE_PAIR_AUDIT are mutually exclusive)
endif
ifeq ($(TH08_PSP_EFFECT_INDEXED_QUADS),1)
$(error TH08_PSP_EFFECT_SPRITE_PAIR_FASTPATH requires the canonical Effect frontend)
endif
CXXFLAGS += -DTH08_PSP_EFFECT_SPRITE_PAIR_FASTPATH=1
else ifneq ($(TH08_PSP_EFFECT_SPRITE_PAIR_FASTPATH),0)
$(error TH08_PSP_EFFECT_SPRITE_PAIR_FASTPATH must be 0 or 1)
endif

ifeq ($(TH08_PSP_EFFECT_INDEXED_QUADS),1)
ifneq ($(TH08_PSP_BULLET_UNIFIED_QUADS),1)
$(error TH08_PSP_EFFECT_INDEXED_QUADS=1 requires TH08_PSP_BULLET_UNIFIED_QUADS=1)
endif
CXXFLAGS += -DTH08_PSP_EFFECT_INDEXED_QUADS=1
else ifneq ($(TH08_PSP_EFFECT_INDEXED_QUADS),0)
$(error TH08_PSP_EFFECT_INDEXED_QUADS must be 0 or 1)
endif

ifeq ($(TH08_PSP_COMPACT_BULLET_VM),1)
CXXFLAGS += -DTH08_PSP_COMPACT_BULLET_VM=1
else ifneq ($(TH08_PSP_COMPACT_BULLET_VM),0)

TH08_UPSTREAM_COMMIT := a940881f97024c99ff387d2cb4c6650fb2bad97f
TH08_ORACLE_COMMIT := 50077aca0ed17d3bb7fee9f69a336636e2474639
TH07_BACKEND_COMMIT := c11c4368bc969f98b731f46fb79067f3528511e7
TH07_GE4_BRIDGE_COMMIT := 202eb1c1fd780bf3db6f55cd8066e174641c6c41
TH08_PSP_BUILD_ID ?= r022-ge4-pspgl-v1-20260901
# Correctness builds keep the full schema-8 replay audit.  Set to 0 only for
# production-load FPS runs; the config stamp prevents stale mixed objects.
TH08_REPLAY_SYNC_AUDIT ?= 1
# Presentation-only Allegrex VFPU path. Set to 0 for the pixel/FPS A/B; game
# simulation, collision, RNG, and replay calculations never use this switch.
TH08_PSP_RENDER_VFPU ?= 1
# PSP-only memoization of the exact binary64 libm values used by the x87
# compatibility gameplay wrappers.  It never substitutes approximate VFPU
# math and remains default-off until replay, surface, hit-rate and FPS gates.
TH08_PSP_X87_TRIG_CACHE ?= 0
# PSP-only word/SWAR implementation of the fixed five-range anti-tamper byte
# checksum. It preserves both RNG calls and applies the canonical per-byte
# uint32 increment as one modulo-2^32 advance. Keep default-off until replay
# and isolated ITEM_TIME/FPS gates pass.
TH08_PSP_ANTITAMPER_SWAR ?= 0
# PSP-only, presentation-only reuse of one canonical binary64 sin/cos pair for
# the outer and inner vertices of zero-secondary-radius radial trails.  It has
# no runtime storage and remains default-off until replay/surface/FPS gates.
TH08_PSP_RADIAL_TRAIL_TRIG_REUSE ?= 0
# PSP-only callback2 scan bound for Reimu/Yukari's Fantasy Seal deathbomb.
# BeginBombSpell still resets all 128 slots; only the update/draw scans use the
# statically proven 0..17 live range. Keep default-off until replay/FPS gates.
TH08_PSP_FANTASY_SEAL_WORK_BOUNDS ?= 0
# PSP-only 653-slot Effect occupancy sidecar.  The original Effect array and
# ascending update order remain authoritative; a bit only avoids touching a
# known-empty 864-byte slot.  Keep default-off until replay/pixel/FPS gates.
TH08_PSP_EFFECT_OCCUPANCY_FASTPATH ?= 0
# PSP-only M0 observer for a future ordinary-Effect GE_SPRITES frontend.  It
# always executes the canonical six-vertex Draw2D path and only compares a
# shadow two-endpoint representation.  Keep default-off outside audit runs.
TH08_PSP_EFFECT_SPRITE_PAIR_AUDIT ?= 0
# PSP-only product selected from the exact M0-proven ordinary Effect set.  It
# emits two final corners through PSPGL's owned current-list GE_SPRITES hook;
# every rejection replays the untouched canonical Draw2D path. Default off
# until replay, pixel, workload, FPS, and hardware gates pass.
TH08_PSP_EFFECT_SPRITE_PAIR_FASTPATH ?= 0
# PSP-only 4V indexed staging for ordinary Effect sprites.  Draw groups and
# state boundaries are unchanged; radial trails retain their canonical strip.
# It reuses the Bullet index table but not Bullet's native/direct-GE owner.
TH08_PSP_EFFECT_INDEXED_QUADS ?= 0
# Set to 0 for the legacy five-VM Bullet runtime A/B.  A layout stamp below
# invalidates every object automatically when this ABI-affecting flag changes.
TH08_PSP_COMPACT_BULLET_VM ?= 1
# PSP-only Bullet occupancy and render-angle sidecar.  The arena reservation
# remains fixed in both variants; this switch changes only the hot-path use so
# replay/pixel/FPS A/B builds have identical gameplay-pool addresses.
TH08_PSP_BULLET_FASTPATH ?= 1
# PSP-only live occupancy enumeration layered on the accepted Bullet sidecar.
# It preserves the canonical 0,1535..1 order and re-reads the bitmap after each
# live Bullet so same-frame child spawns retain the original traversal rules.
# Keep default-off until replay, workload, FPS, pixel, and hardware gates pass.
TH08_PSP_BULLET_LIVE_ENUM ?= 0
# Counter-only observer for the canonical Bullet transform interpreter.  It
# measures terminal/no-op calls and every transform-program writer without
# skipping work or changing Bullet/replay state.  Keep off outside audit runs.
TH08_PSP_BULLET_TRANSFORM_AUDIT ?= 0
# PSP-only 1-bit-per-slot transform-terminal sidecar.  It skips only the
# canonical FIRED-frame interpreter call after that immutable program has
# already returned at index>=18 or NONE.  The initial spawn call always runs.
# Keep default-off until replay, workload, FPS, pixel, and hardware gates pass.
TH08_PSP_BULLET_TRANSFORM_TERMINAL_FASTPATH ?= 0
# PSPGL/D3D8 fixed-function state cache.  Keep this independently switchable
# so replay/pixel/FPS A/B runs change no gameplay code or pool layout.
TH08_PSP_PREPARE_STATE_CACHE ?= 0
# PSP-only enemy-bullet indexed quad submission.  It changes only the vertex
# staging representation inside BulletManager's six draw buckets and remains
# an isolated, default-off replay/pixel/FPS A/B candidate.
TH08_PSP_BULLET_UNIFIED_QUADS ?= 0
# PSPGL-fork native packed submit for the isolated unified enemy-bullet
# batches.  It never starts a raw sceGu list; PSPGL retains list/state/texture
# ownership.  Keep default-off until replay, pixel, FPS, and hardware gates.
TH08_PSP_BULLET_DIRECT_GE ?= 0
# Canonical-authoritative M0 for TH08's fired rotated Bullet frontend.  It
# builds the proposed final 4V quad, then lets Draw2D remain authoritative and
# compares all 112 bytes plus buffer/state/VM effects.  No candidate is drawn.
TH08_PSP_BULLET_ONEPASS_4V_AUDIT ?= 0
# Product gate for the M0-proven frontend.  It retains the existing indexed
# 4V/direct-GE backend and only bypasses generic per-Bullet ANM traversal when
# owner, state, generated-endpoint finite, and typed cursor-capacity proofs
# all hold (the M0 mode additionally verifies the full cursor invariant).
TH08_PSP_BULLET_ONEPASS_4V_FASTPATH ?= 0
# Audit-only proof for a future packed-once Bullet frontend.  The accepted
# indexed 4V direct-GE vertices remain the sole draw authority; this gate
# builds one local final-24B shadow quad and compares it byte-for-byte with the
# canonical backend output.  It never submits candidate geometry.
TH08_PSP_BULLET_PACKED_VERTEX_AUDIT ?= 0
# M1 product for the M0-proven Bullet layout.  The final 24-byte PSP vertices
# are packed once into the existing Present-fenced direct-GE arena at the
# canonical AddSprite boundary, then submitted by the unchanged 4V indexed
# Flush.  Keep independently default-off until replay/pixel/FPS/hardware gates.
TH08_PSP_BULLET_PACKED_VERTEX_FASTPATH ?= 0
# Canonical-authoritative classifier/count audit for a mixed two-corner
# GE_SPRITES prefix followed by the untouched four-corner indexed suffix.
# It keeps the existing v3 PSPGL archive and never substitutes draw output.
TH08_PSP_BULLET_MIXED_QUADS_AUDIT ?= 0
# PSP-only atomic mixed-submit product candidate.  Only this mode selects the
# separately frozen mixed-v1 PSPGL archive; keep default-off until hardware,
# replay, pixel, and stage-relative FPS gates pass.
TH08_PSP_BULLET_MIXED_QUADS_FASTPATH ?= 0
# Canonical-authoritative all-Item classifier audit.  It brackets exactly the
# existing ItemManager traversal and retains its six-vertex renderer.
TH08_PSP_ITEM_MIXED_QUADS_AUDIT ?= 0
# All-Item mixed two-corner prefix/four-corner suffix product candidate.  It
# reuses the fixed Bullet native arena under a disjoint owner token and stays
# default-off pending replay, pixel, FPS, and hardware gates.
TH08_PSP_ITEM_MIXED_QUADS_FASTPATH ?= 0
# PSPGL-fork native packed submit for ItemManager's isolated draw pass.  This
# owns a separate fixed arena/cursor and may not consume the accepted Bullet
# arena.  Keep independently switchable for replay/pixel/FPS A/B.
TH08_PSP_ITEM_DIRECT_GE ?= 0
# ITEM_TIME-triggered natural canonical batches remain 6V in the frontend,
# but an already-existing Flush may pack every quad in that same state/texture
# batch to final 4V client vertices. No Item pass bracket or new flush exists.
TH08_PSP_ITEM_NATURAL_QUADS ?= 0
# PSPGL-owned same-call copy for Item natural 4V batches.  This removes the
# public glDrawElements index scan/generic conversion without retaining either
# caller pointer.  It selects a separately frozen post-v3 archive and remains
# default-off until replay/surface/FPS/hardware gates pass.
TH08_PSP_ITEM_NATURAL_NATIVE_COPY ?= 0

# Link the stream-arena PSPGL archive and lease its parity-0 half only for the
# current synchronous render frame.  Present fences every PSPGL list
# before the lease returns to the render arena, so stage/image decoding sees
# zero resident bytes.  Async/triple Present paths need a separate retirement
# queue and are deliberately excluded.  Default OFF.
TH08_PSP_PSPGL_STREAM_ARENA ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_PSPGL_STREAM_ARENA)),)
$(error TH08_PSP_PSPGL_STREAM_ARENA must be 0 or 1)
endif

# Keep the replay recording capacity blocks across stages (copy the recorded
# span into right-sized blocks at teardown) so the next stage's 0xd2f00
# reservation never hits the fragmented heap (R-046).  Default OFF.
TH08_PSP_REPLAY_RESERVE_RECYCLE ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_REPLAY_RESERVE_RECYCLE)),)
$(error TH08_PSP_REPLAY_RESERVE_RECYCLE must be 0 or 1)
endif

# Exclude the dialogue background snapshot texture from the GE4 upper-tier
# promotion (hardware-only black background during dialogue, R-045).  Default OFF.
TH08_PSP_DIALOGUE_SNAPSHOT_NO_PROMOTE ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_DIALOGUE_SNAPSHOT_NO_PROMOTE)),)
$(error TH08_PSP_DIALOGUE_SNAPSHOT_NO_PROMOTE must be 0 or 1)
endif
# Hardware diagnostic for the dialogue snapshot (readback statistics + magenta
# restore flash).  Default OFF.
TH08_PSP_DIALOGUE_SNAPSHOT_DIAG ?= 0
ifneq ($(filter-out 0 1,$(TH08_PSP_DIALOGUE_SNAPSHOT_DIAG)),)
$(error TH08_PSP_DIALOGUE_SNAPSHOT_DIAG must be 0 or 1)
endif
ifeq ($(TH08_PSP_PSPGL_STREAM_ARENA),1)
ifeq ($(TH08_PSP_SWAP_ASYNC),1)
$(error TH08_PSP_PSPGL_STREAM_ARENA and TH08_PSP_SWAP_ASYNC are mutually exclusive)
endif
ifeq ($(TH08_PSP_SWAP_TRIPLE),1)
$(error TH08_PSP_PSPGL_STREAM_ARENA and TH08_PSP_SWAP_TRIPLE are mutually exclusive)
endif
endif
# PSP-only Player shot/damage-region occupancy sidecar.  Keep the correctness
# baseline off; set to 1 only for an isolated replay/pixel/FPS A/B run.  The
# cache lives outside Player, so neither the gameplay ABI nor replay state
# changes between variants.
TH08_PSP_PLAYER_SCAN_SIDECAR ?= 0
# PSP-only M0 observer for a future TH07-style active-enemy iterator.  It
# compares a producer-maintained 15-word bitmap against the authoritative
# 480-slot loop and never skips gameplay work.
TH08_PSP_ENEMY_ACTIVE_BITMAP_AUDIT ?= 0
# Counter-only proof for a future Player/Bullet collision negative gate.  It
# observes the existing canonical calls and requires the exact Player scan
# sidecar snapshot; no collision result is skipped in this audit generation.
TH08_PSP_BULLET_COLLISION_GATE_AUDIT ?= 0
# PSP-only O(1) empty-cancel-region reject layered on the Player scan
# sidecar.  It is independently default-off so replay/FPS A/B builds can
# isolate the added metadata from the already accepted sidecar candidate.
TH08_PSP_CANCEL_EMPTY_FASTPATH ?= 0
# PSP-only conservative cancel-region coverage gate for Bullet positions.
# It requires both accepted owner sidecars; every uncertain query executes the
# original ascending region scan. Keep default-off until replay/FPS gates pass.
TH08_PSP_BULLET_CANCEL_SPATIAL ?= 0
# Audit-only observer for deciding whether an exact-bit Item autocollect
# velocity cache has enough repeat hits to justify a later optimization.  It
# always executes the canonical atan2/cos/sin path and must stay off in FPS
# production builds.
TH08_PSP_ITEM_AUTOCOLLECT_CACHE_AUDIT ?= 0
# PSP-only exact-bit Item autocollect velocity cache.  It preserves atan2 and
# only reuses previously canonical cos/sin output after a full raw-bit key
# match.  Keep independently default-off for replay/FPS A/B validation.
TH08_PSP_ITEM_AUTOCOLLECT_CACHE ?= 0
# Audit-only full-VM shadow for the stock ITEM_TIME script-68 spawn
# initializer.  The canonical initializer remains authoritative; this gate
# only measures exact replaceable work and must stay off in production/FPS
# builds.
TH08_PSP_ITEM_TIME_SPAWN_INIT_AUDIT ?= 0
# PSP-only product initializer for the stock ITEM_TIME script 68.  A complete
# VM shadow audit must precede each generation-scoped use; all owner/load/
# table/range/fingerprint mismatches execute the canonical dispatcher.
# Keep independently default-off for replay/FPS A/B validation.
TH08_PSP_ITEM_TIME_SPAWN_INIT_FASTPATH ?= 0
# Audit-only byte-for-byte proof for a future stock ITEM_TIME script-68 idle
# fast path.  The authoritative VM still runs the canonical interpreter; the
# shadow result is observational and this must remain off in FPS builds.
TH08_PSP_ITEM_TIME_ANM_IDLE_AUDIT ?= 0
# PSP-only exact stock-script fast path for the ITEM_TIME idle interval proven
# by the audit above.  All non-matching script/owner/VM states fall back to the
# canonical interpreter; keep independently switchable for replay/FPS A/B.
TH08_PSP_ITEM_TIME_ANM_IDLE_FASTPATH ?= 0
# Canonical-authoritative proof that stock ITEM_TIME Draw2D output is an
# axis-aligned two-corner GE_SPRITES candidate.  It never substitutes output.
TH08_PSP_ITEM_TIME_DRAW_PAIR_AUDIT ?= 0
# PSP-only M0 product. Consecutive eligible ITEM_TIME sprites are submitted as
# one PSPGL-owned GL_SPRITES_PSP run; every failed proof remains canonical.
TH08_PSP_ITEM_TIME_DRAW_PAIR_FASTPATH ?= 0
# Canonical-authoritative M0 for the stock axis-aligned ITEM_TIME frontend.
# It builds and byte-compares the proposed four-corner/final-6V output while
# the existing Draw2D path remains the sole draw authority.
TH08_PSP_ITEM_TIME_INLINE_DRAW_AUDIT ?= 0
# PSP-only exact frontend specialization proven by the audit above.  It feeds
# the existing AddSpriteToDrawBuffer boundary, so draw order and the selected
# canonical 6V or separately gated 4V backend remain unchanged.
TH08_PSP_ITEM_TIME_INLINE_DRAW_FASTPATH ?= 0
# PSP-only presentation sidecar for score/time popup active slots.  The fixed
# retail arrays and ascending slot order remain authoritative; this gate only
# skips known-empty entries in update/draw and is independently A/B-able.
TH08_PSP_ASCII_POPUP_OCCUPANCY ?= 0
# Score-popup-only frontend batch ported from the hardware-proven TH07 idea,
# but re-derived for TH08's glyph-10 animation and nearbyintf pixel contract.
# It remains default-off until replay, pixel, FPS, and hardware gates pass.
TH08_PSP_ASCII_POPUP_BATCH ?= 0
# PSP-only second-stage score-popup frontend.  The accepted pair batch remains
# the owner/backend; this independently gated path replaces its validation
# quad plus generation quad with metadata-only proof and one direct two-corner
# generation pass.  Keep default-off until replay/pixel/FPS/hardware gates.
TH08_PSP_ASCII_POPUP_DIRECT_PAIR ?= 0
# M0 score-popup-only native GE_SPRITES submit. PSPGL copies the already
# packed two-corner stream into its own immediate stream buffer, so the
# existing staging allocation remains reusable and no delayed arena is added.
# timePopups and Item's ITEM_TIME emitter remain separate and untouched.
TH08_PSP_SCORE_POPUP_NATIVE_GE ?= 0
# Diagnostic-only stage-relative 300-frame sampler used to make performance
# A/B windows independent of host-side startup jitter.  It does not change
# game, replay, render, or audio state and remains off in shipped builds.
TH08_PSP_STAGE_RELATIVE_PERF_SAMPLING ?= 0
# Exact module/thread/newlib declaration parity with the hardware-proven TH07
# port. Set to 0 only for the former TH08 startup-contract hardware A/B.
TH08_PSP_TH07_BOOT_PARITY ?= 1
# Prefer the user-local TH08 font subset after the generated canonical CP932
# decoder and the 1,531-codepoint authority both pass their runtime gates.
# Missing, incomplete, or mismatched candidates fall back to full MS Gothic,
# the redistributable OFL stock-profile subset, and then full Noto without
# changing the required game-text coverage.
TH08_PSP_LOCAL_FONT_SUBSET ?= 1
# Default-off TH07 export: keep SDL_ttf glyphs across same-face/same-size
# descriptor releases only on runtime model > 0 (Slim+/Go).  Model 0 and a
# failed model query retain the established per-row flush.
TH08_PSP_FONT_GLYPH_CACHE_RETAIN ?= 0

GENERATED_DIR := build/psp-generated
GENERATED_I18N := $(GENERATED_DIR)/i18n.hpp
GE4_MODEL_GATE_CONFIG_STAMPS := \
	$(GENERATED_DIR)/ge4-slimplus-0.stamp \
	$(GENERATED_DIR)/ge4-slimplus-1.stamp
GE4_MODEL_GATE_CONFIG_STAMP := $(GENERATED_DIR)/ge4-slimplus-$(TH08_PSP_SLIMPLUS_GE4).stamp
BULLET_VM_CONFIG_STAMPS := \
	$(GENERATED_DIR)/bullet-vm-layout-0.stamp \

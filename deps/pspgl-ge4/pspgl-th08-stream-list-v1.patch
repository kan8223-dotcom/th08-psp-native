+/* Hand the list to the GE with the stall at the write pointer. */
+static void dlist_stream_start (struct pspgl_dlist *d)
+{
+	if (d->qid != -1 || d->len == 0)
+		return;
+	if (pspgl_curctx->stats.enabled)
+		pspgl_curctx->stats.buffer_issues++;
+	d->qid = sceGeListEnQueue(d->cmd_buf, &d->cmd_buf[d->len], 0, NULL);
+	d->stall_len = d->len;
+}
+
+/* Release everything written so far. */
+static void dlist_stall_advance (struct pspgl_dlist *d)
+{
+	if (d->qid == -1 || d->finished || d->len <= d->stall_len)
+		return;
+	sceGeListUpdateStallAddr(d->qid, &d->cmd_buf[d->len]);
+	d->stall_len = d->len;
+}

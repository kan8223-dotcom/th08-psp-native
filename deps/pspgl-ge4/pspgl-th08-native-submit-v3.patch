diff --git a/glDrawArrays.c b/glDrawArrays.c
index 577c012..11a5d92 100644
--- a/glDrawArrays.c
+++ b/glDrawArrays.c
@@ -1,4 +1,75 @@
+#include <stdint.h>
+#include <string.h>
+
 #include "pspgl_internal.h"
+#include "pspgl_buffers.h"
+#include "pspgl_dlist.h"
+
+const char __pspgl_th08_native_submit_marker[] =
+	"pspGL TH08 native submit v3 indexed-no-copy sprite-copy upstream "
+	"de4260adf56d06516ec46018d404ca77e0b61748 base ge4-v1";
+
+
+int __pspgl_th08_draw_native_sprite_pairs_copy(
+	const void *vertices, unsigned vertex_bytes);
+
+
+/* TH08-private packed GE_SPRITES path for one immediate popup batch.
+ *
+ * Unlike the indexed path, the caller's staging range may be reused as soon
+ * as this function returns.  Copy it into a PSPGL stream buffer, pin that
+ * buffer to PSPGL's current display list, and retain normal PSPGL ownership
+ * of draw/texture/state lifetimes.  This removes the public client-array state
+ * setup and generic vertex-format inspection without starting a raw GU list.
+ */
+int __pspgl_th08_draw_native_sprite_pairs_copy(
+	const void *vertices, unsigned vertex_bytes)
+{
+	const unsigned vertex_stride = 24;
+	const unsigned vertex_format =
+		GE_TEXTURE_32BITF | GE_COLOR_8888 | GE_VERTEX_32BITF |
+		GE_TRANSFORM_3D;
+	uintptr_t begin = (uintptr_t)vertices;
+	uintptr_t end;
+	unsigned vertex_count;
+	struct pspgl_buffer *vbuf;
+	void *copy;
+
+	/* Reject everything before allocating, copying, or emitting GE state.
+	 * CMD_PRIM carries a 16-bit count and GE_SPRITES consumes vertex pairs. */
+	if (pspgl_curctx == NULL || pspgl_curctx->draw == NULL ||
+	    pspgl_curctx->draw->draw == NULL ||
+	    *pspgl_curctx->draw->draw == NULL || __pspgl_actuallist != NULL)
+		return 0;
+	if (vertices == NULL || vertex_bytes == 0 ||
+	    (begin & (sizeof(float) - 1)) != 0)
+		return 0;
+	end = begin + (uintptr_t)vertex_bytes;
+	if (end < begin || (vertex_bytes % vertex_stride) != 0)
+		return 0;
+
+	vertex_count = vertex_bytes / vertex_stride;
+	if (vertex_count == 0 || vertex_count > 0xffffu ||
+	    (vertex_count % 2u) != 0)
+		return 0;
+
+	vbuf = __pspgl_buffer_new(vertex_bytes, GL_STREAM_DRAW_ARB);
+	if (vbuf == NULL)
+		return 0;
+	copy = __pspgl_buffer_map(vbuf, GL_WRITE_ONLY_ARB);
+	if (copy == NULL) {
+		__pspgl_buffer_free(vbuf);
+		return 0;
+	}
+	memcpy(copy, vertices, vertex_bytes);
+	__pspgl_buffer_unmap(vbuf, GL_WRITE_ONLY_ARB);
+
+	__pspgl_context_render_prim(pspgl_curctx, GE_SPRITES, vertex_count,
+				    vertex_format, vbuf->base, NULL);
+	__pspgl_dlist_pin_buffer(vbuf, BF_PINNED_RD);
+	__pspgl_buffer_free(vbuf);
+	return 1;
+}
 
 

diff --git a/glDrawElements.c b/glDrawElements.c
index c173776..a0695fe 100644
--- a/glDrawElements.c
+++ b/glDrawElements.c
@@ -1,5 +1,73 @@
+#include <stdint.h>
+#include <psputils.h>
+
 #include "pspgl_internal.h"
 
+int __pspgl_th08_draw_native_indexed_triangles(
+	const void *vertices, unsigned vertex_bytes,
+	const unsigned short *indices, unsigned index_bytes,
+	unsigned index_count);
+
+static int th08_native_range_valid(const void *address, unsigned bytes,
+				   unsigned alignment)
+{
+	uintptr_t begin = (uintptr_t)address;
+	uintptr_t end;
+
+	if (address == NULL || bytes == 0 || (begin & (alignment - 1)) != 0)
+		return 0;
+	end = begin + (uintptr_t)bytes;
+	return end >= begin;
+}
+
+/* TH08-private no-copy submit path for an application-owned packed stream.
+ *
+ * The caller has already validated that every immutable u16 index is below
+ * vertex_bytes / 24.  Repeating that min/max scan here would recreate the
+ * generic glDrawElements toll this entry point exists to remove.  Both ranges
+ * must remain immutable until the swap/present fence has completed.
+ */
+int __pspgl_th08_draw_native_indexed_triangles(
+	const void *vertices, unsigned vertex_bytes,
+	const unsigned short *indices, unsigned index_bytes,
+	unsigned index_count)
+{
+	const unsigned vertex_stride = 24;
+	const unsigned vertex_format =
+		GE_TEXTURE_32BITF | GE_COLOR_8888 | GE_VERTEX_32BITF |
+		GE_TRANSFORM_3D | GE_VINDEX_16BIT;
+	unsigned vertex_count;
+
+	/* Reject everything before touching the caller ranges or emitting GE
+	 * state.  CMD_PRIM carries a 16-bit count. */
+	if (pspgl_curctx == NULL || pspgl_curctx->draw == NULL ||
+	    pspgl_curctx->draw->draw == NULL ||
+	    *pspgl_curctx->draw->draw == NULL || __pspgl_actuallist != NULL)
+		return 0;
+	if (!th08_native_range_valid(vertices, vertex_bytes, sizeof(float)) ||
+	    !th08_native_range_valid(indices, index_bytes,
+				     sizeof(*indices)))
+		return 0;
+	if ((vertex_bytes % vertex_stride) != 0 ||
+	    index_count == 0 || index_count > 0xffffu ||
+	    (index_count % 3u) != 0 ||
+	    index_bytes != index_count * (unsigned)sizeof(*indices))
+		return 0;
+
+	vertex_count = vertex_bytes / vertex_stride;
+	if (vertex_count == 0 || vertex_count > 0x10000u)
+		return 0;
+
+	/* These are caller-owned Main RAM ranges, not PSPGL buffer objects.  Their
+	 * append-only frame lifetime is what keeps them valid after this returns. */
+	sceKernelDcacheWritebackRange(vertices, vertex_bytes);
+	sceKernelDcacheWritebackRange(indices, index_bytes);
+
+	__pspgl_context_render_prim(pspgl_curctx, GE_TRIANGLES, index_count,
+				    vertex_format, vertices, indices);
+	return 1;
+}
+
 
 void glDrawElements (GLenum mode, GLsizei count, GLenum type, const GLvoid *indices)
 {
